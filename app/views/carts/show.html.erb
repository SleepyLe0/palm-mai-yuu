<h1>Your Cart</h1>

<% if notice %>
  <p><%= notice %></p>
<% end %>
<% if alert %>
  <p><%= alert %></p>
<% end %>

<h2>Products</h2>
<ul>
  <% @products.each do |product| %>
    <li>
      <%= product.name %> (<%= product.category.humanize %>) - $<%= product.price %>
      <%= form_with url: cart_items_path, method: :post do |form| %>
        <%= form.hidden_field :product_id, value: product.id, name: "cart_item[product_id]" %>
        <%= form.number_field :quantity, name: "cart_item[quantity]", value: 1, min: 1 %>
        <%= form.submit "Add to cart" %>
      <% end %>
    </li>
  <% end %>
</ul>

<h2>Cart Items</h2>
<% if @cart.cart_items.empty? %>
  <p>Your cart is empty.</p>
<% else %>
  <ul>
    <% @cart.cart_items.each do |item| %>
      <li>
        <%= item.product.name %> -
        <%= form_with url: cart_item_path(item), method: :patch do |form| %>
          <%= form.number_field :quantity, name: "cart_item[quantity]", value: item.quantity, min: 1 %>
          <%= form.submit "Update" %>
        <% end %>
        @ $<%= item.unit_price %> each = $<%= item.quantity * item.unit_price %>
        <%= button_to "Remove", cart_item_path(item), method: :delete %>
      </li>
    <% end %>
  </ul>

  <p>Total quantity: <%= @cart.total_quantity %></p>
  <p>Total price: $<%= @cart.total_price %></p>
<% end %>
