<h1>Your Cart</h1>

<% if notice %>
  <p><%= notice %></p>
<% end %>
<% if alert %>
  <p><%= alert %></p>
<% end %>

<h2>Cart Items</h2>
<% if @cart.cart_items.empty? %>
  <p>Your cart is empty.</p>
<% else %>
  <ul>
    <% @cart.cart_items.each do |item| %>
      <li>
        <%= item.product.name %> -
        <%= form_with url: cart_item_path(item), method: :patch do |form| %>
          <%= form.number_field :quantity, name: "cart_item[quantity]", value: item.quantity, min: 1 %>
          <%= form.submit "Update" %>
        <% end %>
        @ <%= number_to_currency item.unit_price %> each = <%= number_to_currency item.quantity * item.unit_price %>
        <%= button_to "Remove", cart_item_path(item), method: :delete %>
        <% if item.exceeds_stock? %>
          <p><strong>Only <%= item.product.stock_count.to_i %> left in stock — adjust before checkout.</strong></p>
        <% end %>
      </li>
    <% end %>
  </ul>

  <p>Total quantity: <%= @cart.total_quantity %></p>
  <p>Total price: <%= number_to_currency @cart.total_price %></p>

  <%= link_to "Proceed to checkout", new_order_path %>
<% end %>

<%= link_to "Continue shopping", products_path %>

<p><%= link_to "Your orders", orders_path %></p>
