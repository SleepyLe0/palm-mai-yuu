<h1>Order <%= @order.number %></h1>

<% if notice %>
  <p><%= notice %></p>
<% end %>

<p>Status: <%= @order.status.humanize %></p>
<p>Placed on: <%= @order.created_at.to_fs(:long) %></p>
<p>Name: <%= @order.full_name %></p>
<p>Email: <%= @order.email %></p>

<h2>Items</h2>
<ul>
  <% @order.order_items.each do |item| %>
    <li>
      <%= item.product_name %> &times; <%= item.quantity %>
      @ <%= number_to_currency item.unit_price %> = <%= number_to_currency item.total_price %>
    </li>
  <% end %>
</ul>

<p>Total: <%= number_to_currency @order.total_amount %></p>

<%= link_to "All orders", orders_path %>
<%= link_to "Continue shopping", cart_path %>
