<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<% content_for :title, "Products" %>

<div style="display: flex; align-items: center; gap: 20px;">
    <h1>Products</h1>
    <%= link_to "New product", new_product_path %>
</div>

<span style="display: flex; gap: 20px; padding-bottom: 20px;">
  <%= form_with url: products_path, method: :get, local: true do |form| %>
    <%= form.select :category,
        Product.categories.map { |key, label| [label, key] },
        { prompt: "All Categories" } %>

    <%= form.submit "Filter" %>
  <% end %>

  <%= link_to "🛒 View my cart", cart_path %>
</span>

<div id="products">
  <% @products.each do |product| %>
    <%= render product %>
    <p>
      <%= link_to "Show this product", product %>
    </p>
    <%= form_with url: cart_items_path, method: :post do |form| %>
      <%= form.hidden_field :product_id, value: product.id, name: "cart_item[product_id]" %>
      <%= form.number_field :quantity, name: "cart_item[quantity]", value: 1, min: 1 %>
      <%= form.submit "Add to cart" %>
    <% end %>
  <% end %>
</div>
