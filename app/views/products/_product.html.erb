<div id="<%= dom_id product %>">
  <div>
    <h2>Name:
      <%= product.name %>
    </h2>
  </div>

  <div>
    <strong>Price:</strong>
    <% if product.on_sale? %>
      <s><%= number_to_currency product.price %></s>
      <%= number_to_currency product.current_price %>
    <% else %>
      <%= number_to_currency product.price %>
    <% end %>
  </div>

  <div>
    <strong>Stock count:</strong>
    <%= product.stock_count %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= product.category %>
  </div>
</div>
