<div id="<%= dom_id product %>">
  <div>
    <h2>Name:
      <%= product.name %>
    </h2>
  </div>

  <div>
    <strong>Price:</strong>
    <%= product.price %>
  </div>

  <div>
    <strong>Stock count:</strong>
    <%= product.stock_count %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= product.category %>
  </div>
</div>
